# =============================================================================
# .env.example — 20-Generative_AI_and_Prompt_Engineer
#
# Bu klasördeki scriptleri çalıştırmak için gereken API anahtarlarının
# örnek listesidir. Kullanmak için:
#   1. Bu dosyayı aynı klasöre ".env" adıyla kopyalayın
#   2. Aşağıdaki değerleri kendi API anahtarlarınızla doldurun
#   3. ".env" dosyasını ASLA git'e commit etmeyin (zaten .gitignore'da olmalı)
#
# NOT: Bu klasördeki scriptler aynı anahtar için farklı isimlendirme
# kuralları kullanıyor (bazıları "OPENAI_API_KEY", bazıları "openai_apikey"
# şeklinde okuyor). Ortam değişkenleri Linux/macOS'ta büyük/küçük harfe
# duyarlıdır; bu yüzden aşağıda HER İKİ varyant da aynı değerle
# tanımlanmıştır. Hangi scripti çalıştırırsanız çalıştırın anahtar bulunur.
# =============================================================================

# --- OpenAI (GPT, DALL-E, Whisper, TTS) ---
OPENAI_API_KEY=sk-your-openai-key-here
openai_apikey=${OPENAI_API_KEY}

# --- Google Gemini ---
GOOGLE_API_KEY=your-google-api-key-here
google_apikey=${GOOGLE_API_KEY}

# --- Anthropic Claude ---
anthropic_apikey=your-anthropic-key-here

# --- Cohere ---
cohere_apikey=your-cohere-key-here

# --- AssemblyAI (Ses -> Metin) ---
assemblyai_apikey=your-assemblyai-key-here

# --- Stability AI (Görsel üretimi) ---
stabilityai_apikey=your-stabilityai-key-here

# --- Hugging Face (Embedding / Inference API) ---
huggingface_access_token=your-huggingface-access-token-here

# --- Tavily (Web arama aracı — AI ajanlar için) ---
TAVILY_API_KEY=your-tavily-key-here
tavily_apikey=${TAVILY_API_KEY}
